Checkpoint backups/
delete/
brewops-notifications-setup/
*.zip
*.jpg
*.JPG
# ...but the qbrew.app landing page's own photography is real source, not a
# stray screenshot -- the blanket *.jpg rule above would silently drop it.
!assets/landing/*.jpg
node_modules/

# Native app wrappers (apps/<name>/ -- one per Capacitor project, e.g.
# apps/lietard/, apps/staff/). Generic per-app wildcard rather than one
# block per app name, so a new app added under apps/ is covered
# automatically without remembering to extend this file too.
apps/*/android/local.properties
apps/*/**/.gradle/
apps/*/**/build/
apps/*/**/.idea/
apps/*/android/app/release/
*.iml
# iOS/Xcode -- Pods/ is CocoaPods' resolved dependency tree (regenerated by
# `pod install`, same idea as node_modules/); xcuserdata/ and DerivedData
# are per-developer editor/build state, never shared.
apps/*/ios/App/Pods/
apps/*/**/xcuserdata/
apps/*/**/DerivedData/
